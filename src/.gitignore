# --- JavaScript / CDK -------------------------------------------------------
node_modules/
cdk.out/
dist/
*.js
*.d.ts
!scripts/*.js
cdk.context.json

# --- Python -----------------------------------------------------------------
# The venv is per-machine and holds compiled wheels for the LOCAL platform;
# committing it would also ship macOS binaries to a Linux CI runner.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Build output -----------------------------------------------------------
# build/lambda is the deployment bundle: shapely + numpy + a copy of the source,
# ~51MB of compiled linux/aarch64 wheels. Regenerated by `make bundle`, so it is
# derived, machine-specific, and far too large to track. If it were committed,
# a stale bundle would also silently deploy over a fresh source change.
build/
build.log

# --- Local credentials and secrets ------------------------------------------
# API keys reach the tools via env vars or Secrets Manager, never a file in the
# repo (ADR 0004). This is belt and braces for a .env someone creates anyway.
.env
.env.*
!.env.example

# --- Generated snapshots ----------------------------------------------------
# Generated by `make strip` - a snapshot of live feed output, not source.
docs/strip/data.json

# --- Generated corridor geometry cache -------------------------------------
# scripts/fetch-arnold.py caches each NTAD response page here so a rerun resumes
# instead of re-hitting the service. Derived and machine-local.
#
# NOTE: reference/corridor.json and sql/002-corridor-real.sql ARE tracked. They
# were briefly untracked for a licensing reason that no longer applies - the
# geometry now comes from the federal NTAD National Highway System, which grants
# free redistribution, rather than from four state DOT layers that did not. See
# /NOTICE.
build/arnold-cache/

# --- Diagram sources --------------------------------------------------------
# The exported PNGs (architecture.png, lifecycle.png) are what the docs embed and
# what reviewers read, so those ARE tracked. The .drawio sources are kept locally
# for editing but stay out of git: they are 58KB of generated XML that rewrites
# whole-file on every save, so they diff as noise and would be re-exported anyway.
# KEEP YOUR LOCAL COPIES - re-export with draw.io after editing:
#   /Applications/draw.io.app/Contents/MacOS/draw.io --export --format png \
#     --scale 2 --border 0 --output architecture.png <source>.drawio
docs/diagrams/*.drawio

# The UI is its own npm package with its own lockfile; build output and any local
# env overrides stay out of git.
ui/node_modules/
ui/dist/
ui/.env.local
ui-trace/node_modules/
ui-trace/dist/
ui-trace/.env.local

# The API pid file written by `make ui` so Ctrl-C can stop both processes.
.strip-api.pid

# --- OS / editor ------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
